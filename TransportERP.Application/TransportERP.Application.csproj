<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- A governed release overrides this at build time. It is embedded in the signed assembly;
         clients never accept a runtime, UI, argument, environment or file override. -->
    <TransportERPClientPublicOrigin Condition="'$(TransportERPClientPublicOrigin)' == ''">https://sync.example.test/</TransportERPClientPublicOrigin>
    <!-- A governed build must pass /p:TransportERPImplementationSha=<exact 40-char commit>.
         UNBOUND is intentionally fail-closed and cannot authorize an Offline runtime. -->
    <TransportERPImplementationSha Condition="'$(TransportERPImplementationSha)' == ''">UNBOUND</TransportERPImplementationSha>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="TransportERPClientPublicOrigin" Value="$(TransportERPClientPublicOrigin)" />
    <AssemblyMetadata Include="TransportERPImplementationSha" Value="$(TransportERPImplementationSha)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransportERP\TransportERP.Domain.csproj" />
    <ProjectReference Include="..\TransportERP.Contracts\TransportERP.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TransportERP.Tests" />
  </ItemGroup>

</Project>
