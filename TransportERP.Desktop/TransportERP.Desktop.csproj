<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Current repository state exposes the recovered Desktop contract surface only.
         No executable entry point is issued yet, so keep the project buildable as a library. -->
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransportERP.Contracts\TransportERP.Contracts.csproj" />
  </ItemGroup>

</Project>
