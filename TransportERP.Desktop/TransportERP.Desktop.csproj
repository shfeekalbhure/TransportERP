<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransportERP.Contracts\TransportERP.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Helpers\" />
    <Folder Include="Models\" />
    <Folder Include="Services\" />
    <Folder Include="Resources\" />
    <Folder Include="Themes\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Forms\Setup\General\**\*.cs" />
    <EmbeddedResource Remove="Forms\Setup\General\**\*.resx" />
    <Compile Remove="Forms\Security\**\*.cs" />
    <EmbeddedResource Remove="Forms\Security\**\*.resx" />
    <Compile Remove="Forms\Accounting\**\*.cs" />
    <EmbeddedResource Remove="Forms\Accounting\**\*.resx" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Forms\\FrmCountries.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\Setup\Geographic\FrmAreas.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\Setup\Geographic\FrmDirectorates.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

</Project>
