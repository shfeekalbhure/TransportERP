    <Compile Update="Properties/Resources.Designer.cs"><DesignTime>True</DesignTime><AutoGen>True</AutoGen><DependentUpon>Resources.resx</DependentUpon></Compile>
    <EmbeddedResource Update="Properties/Resources.resx"><Generator>ResXFileCodeGenerator</Generator><LastGenOutput>Resources.Designer.cs</LastGenOutput></EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
