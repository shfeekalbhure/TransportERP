<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransportERP.Contracts\TransportERP.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Helpers\" />
    <Folder Include="Models\" />
    <Folder Include="Services\" />
    <Folder Include="Resources\" />
    <Folder Include="Themes\" />
  </ItemGroup>

  <!--
    شاشة الدول مبنية حاليًا بالكامل داخل FrmCountries.cs.
    نستبعد أي ملفات جزئية قديمة مثل FrmCountries.Designer.cs أو نسخ احتياطية مشابهة
    حتى لا تدخل في التجميع وتعيد تعريف الكلاس أو تغير نوعه الأساسي من Form إلى object.
  -->
  <ItemGroup>
    <Compile Remove="Forms\FrmCountries.*.cs" />
    <EmbeddedResource Remove="Forms\FrmCountries.*.resx" />
    <Compile Update="Forms\FrmCountries.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Forms\Setup\Geographic\FrmAreas.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\Setup\Geographic\FrmDirectorates.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

</Project>