<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The repository can carry the Desktop contract surface before the executable shell is restored.
         Build as WinExe only when the real entry point exists; otherwise keep the project visible/buildable as a library. -->
    <HasDesktopEntryPoint Condition="Exists('Program.cs')">true</HasDesktopEntryPoint>
    <HasDesktopEntryPoint Condition="'$(HasDesktopEntryPoint)' == ''">false</HasDesktopEntryPoint>
    <OutputType Condition="'$(HasDesktopEntryPoint)' == 'true'">WinExe</OutputType>
    <OutputType Condition="'$(HasDesktopEntryPoint)' != 'true'">Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransportERP.Contracts\TransportERP.Contracts.csproj" />
    <None Update="Resources/GoldenIcons/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Resources/GoldenIcons/ATTRIBUTION.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="CoreUI/*.cs;Forms/Templates/**/*.cs" />
    <EmbeddedResource Remove="CoreUI/*.resx;Forms/Templates/**/*.resx" />
