<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Keep the Mobile project visible in the solution even when the MAUI runtime scaffold is not yet present in Git.
         As soon as the real scaffold/resources exist, the project automatically returns to its executable MAUI configuration. -->
    <MauiRuntimeReady Condition="Exists('MauiProgram.cs') and Exists('App.xaml') and Exists('App.xaml.cs') and Exists('Platforms') and Exists('Resources\AppIcon\appicon.svg') and Exists('Resources\AppIcon\appiconfg.svg') and Exists('Resources\Splash\splash.svg')">true</MauiRuntimeReady>
    <MauiRuntimeReady Condition="'$(MauiRuntimeReady)' == ''">false</MauiRuntimeReady>

    <TargetFramework Condition="'$(MauiRuntimeReady)' != 'true'">net10.0</TargetFramework>
    <TargetFrameworks Condition="'$(MauiRuntimeReady)' == 'true'">net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(MauiRuntimeReady)' == 'true' and !$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="'$(MauiRuntimeReady)' == 'true' and $([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType Condition="'$(MauiRuntimeReady)' == 'true'">Exe</OutputType>
    <OutputType Condition="'$(MauiRuntimeReady)' != 'true'">Library</OutputType>
    <RootNamespace>TransportERP.Mobile.Driver</RootNamespace>
    <UseMaui Condition="'$(MauiRuntimeReady)' == 'true'">true</UseMaui>
    <SingleProject Condition="'$(MauiRuntimeReady)' == 'true'">true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiXamlInflator Condition="'$(MauiRuntimeReady)' == 'true'">SourceGen</MauiXamlInflator>

    <ApplicationTitle Condition="'$(MauiRuntimeReady)' == 'true'">TransportERP.Mobile.Driver</ApplicationTitle>
    <ApplicationId Condition="'$(MauiRuntimeReady)' == 'true'">com.companyname.transporterp.mobile.driver</ApplicationId>
    <ApplicationDisplayVersion Condition="'$(MauiRuntimeReady)' == 'true'">1.0</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(MauiRuntimeReady)' == 'true'">1</ApplicationVersion>
    <WindowsPackageType Condition="'$(MauiRuntimeReady)' == 'true'">None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="'$(MauiRuntimeReady)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(MauiRuntimeReady)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(MauiRuntimeReady)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(MauiRuntimeReady)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="'$(MauiRuntimeReady)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(MauiRuntimeReady)' == 'true'">
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(MauiRuntimeReady)' == 'true'">
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransportERP.Offline\TransportERP.Offline.csproj" />
  </ItemGroup>

</Project>
