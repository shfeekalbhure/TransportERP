{
  "RequestPolicy": {
    "DefaultPageSize": 100,
    "MaximumPageSize": 200,
    "MaximumLookupResults": 50,
    "OutboundTimeoutSeconds": 15,
    "MaximumAttempts": 3,
    "InitialBackoffMilliseconds": 250,
    "MaximumJitterMilliseconds": 100,
    "AutomaticRetryMethods": [ "GET", "HEAD", "OPTIONS" ]
  },
  "Authentication": {
    "JwtBearer": {
      "Issuer": "TransportERP",
      "Audience": "TransportERP.Api",
      "SigningKey": "TransportERP-development-only-signing-key-change-in-deployment-2026"
    }
  },
  "Downstream": {
    "StatusUrl": "https://localhost:7443/health"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
