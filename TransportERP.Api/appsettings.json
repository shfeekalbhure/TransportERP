{
  "RequestPolicy": {
    "DefaultPageSize": 100,
    "MaximumPageSize": 500,
    "MaximumLookupResults": 100,
    "OutboundTimeoutSeconds": 15,
    "MaximumAttempts": 3,
    "InitialBackoffMilliseconds": 250,
    "MaximumJitterMilliseconds": 100,
    "AutomaticRetryMethods": [ "GET", "HEAD", "OPTIONS" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
