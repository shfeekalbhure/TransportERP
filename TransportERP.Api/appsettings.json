{
  "AllowedHosts": "localhost;127.0.0.1",
  "Sync": {
    "Offline": {
      "Enabled": false,
      "AllowedActions": [
        "CreateJournalEntry",
        "CreateReceiptVoucher",
        "CreatePaymentVoucher",
        "CreateWaybillDraft",
        "UpdateWaybillDraft",
        "CreateOperationalParty",
        "AddWaybillAttachment",
        "RecordCollection",
        "LoadAllocatedQuantity",
        "RecordArrival",
        "RecordUnload",
        "DeliverQuantity",
        "RecordProofOfDelivery",
        "CreateShipmentException"
      ]
    },
    "ServerExecution": {
      "Enabled": false
    },
    "Protocol": {
      "AllowedVersions": [ "sync-v1" ]
    },
    "Retry": {
      "ClientTransport": {
        "MaxCount": 5,
        "BaseSeconds": 5,
        "MaxDelayMinutes": 30
      },
      "ServerExecution": {
        "MaxCount": 5,
        "BaseSeconds": 5,
        "MaxDelayMinutes": 30
      }
    },
    "Batch": {
      "MaxOperations": 100
    },
    "Conflict": {
      "AutoMerge": false
    },
    "Retention": {
      "LocalSuccessHours": 24,
      "LocalRejectedDays": 7,
      "ServerPayloadDays": 90
    },
    "Cache": {
      "MaxAgeHours": 24
    },
    "Proof": {
      "MaximumPastSeconds": 120,
      "MaximumFutureSeconds": 30,
      "NonceLifetimeSeconds": 300,
      "ReplayRetentionSeconds": 600,
      "MaximumRequestBodyBytes": 2097152,
      "MaximumPayloadBytes": 16384,
      "ForwardedHeadersEnabled": false,
      "KnownProxies": [],
      "KnownNetworks": []
    }
  }
}
